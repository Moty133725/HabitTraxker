<Window x:Class="HabitTrackerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HabitTrackerApp"
        mc:Ignorable="d"
        Title="Менеджер привычек v1.0" Height="700" Width="1100"
        Background="White">

    <Window.Resources>
        <local:EqualityConverter x:Key="EqualityConverter"/>
        <local:BoolToStatusConverter x:Key="BoolToStatusConverter"/>

        <!-- Стиль для дат с выполненными привычками -->
        <Style x:Key="CompletedDayStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0" Background="#F0F0F0">
            <MenuItem Header="Файл">
                <MenuItem Header="Сохранить" Click="Save_Click"/>
                <MenuItem Header="Загрузить" Click="Load_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Header="Копировать" Click="Copy_Click"/>
                <MenuItem Header="Вставить" Click="Paste_Click"/>
            </MenuItem>
            <MenuItem Header="Вид">
                <MenuItem Header="Светлая тема" Click="LightTheme_Click"/>
                <MenuItem Header="Темная тема" Click="DarkTheme_Click"/>
            </MenuItem>
        </Menu>

        <!-- ToolBar -->
        <ToolBar Grid.Row="1" Background="#E0E0E0">
            <Button Content="Сохранить" Click="Save_Click" Margin="2" Width="70"/>
            <Button Content="Загрузить" Click="Load_Click" Margin="2" Width="70"/>
            <Separator/>
            <Button Content="Светлая" Click="LightTheme_Click" Margin="2" Width="60"/>
            <Button Content="Темная" Click="DarkTheme_Click" Margin="2" Width="60"/>
        </ToolBar>

        <!-- Основная рабочая область с TabControl -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: Вкладки и данные пользователя -->
            <TabControl Grid.Column="0" Margin="5">
                <TabItem Header="Личные данные">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Аватар -->
                            <GroupBox Header="Аватар" Margin="5" Padding="5">
                                <StackPanel>
                                    <Border BorderBrush="Gray" BorderThickness="1" Width="100" Height="100" HorizontalAlignment="Center">
                                        <Image x:Name="AvatarImage" Stretch="Uniform"/>
                                    </Border>
                                    <Button Content="Загрузить фото..." Click="LoadAvatar_Click" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- GroupBox 1: Основная информация -->
                            <GroupBox Header="Основная информация" Margin="5" Padding="5">
                                <StackPanel>
                                    <Label Content="Имя:"/>
                                    <TextBox x:Name="FirstNameBox" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Label Content="Фамилия:"/>
                                    <TextBox x:Name="LastNameBox" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Label Content="Пароль:"/>
                                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>

                                    <Label Content="Дата рождения:"/>
                                    <DatePicker x:Name="BirthDatePicker" SelectedDate="{Binding BirthDate}"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- GroupBox 2: Дополнительные данные -->
                            <GroupBox Header="Дополнительные данные" Margin="5" Padding="5">
                                <StackPanel>
                                    <Label Content="Образование:"/>
                                    <ComboBox x:Name="EducationCombo" SelectedValue="{Binding Education}">
                                        <ComboBoxItem Content="Среднее"/>
                                        <ComboBoxItem Content="Среднее специальное"/>
                                        <ComboBoxItem Content="Высшее"/>
                                        <ComboBoxItem Content="Аспирантура"/>
                                    </ComboBox>

                                    <Label Content="Хобби:"/>
                                    <ListBox x:Name="HobbiesListBox" SelectionMode="Multiple" Height="80"
                                             SelectionChanged="HobbiesListBox_SelectionChanged">
                                    </ListBox>
                                </StackPanel>
                            </GroupBox>

                            <!-- GroupBox 3: Настройки отображения -->
                            <GroupBox Header="Настройки отображения" Margin="5" Padding="5">
                                <StackPanel>
                                    <CheckBox Content="Получать уведомления" IsChecked="{Binding ReceiveNotifications}"/>
                                    <CheckBox Content="Показывать статистику публично" IsChecked="{Binding ShowPublicStats}"/>
                                    <CheckBox Content="Автосохранение" IsChecked="{Binding AutoSave}"/>

                                    <Label Content="Уровень активности:" Margin="0,10,0,0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Низкий" GroupName="Activity" 
                                                     IsChecked="{Binding ActivityLevel, Converter={StaticResource EqualityConverter}, ConverterParameter=Низкий}"/>
                                        <RadioButton Content="Средний" GroupName="Activity" 
                                                     IsChecked="{Binding ActivityLevel, Converter={StaticResource EqualityConverter}, ConverterParameter=Средний}"/>
                                        <RadioButton Content="Высокий" GroupName="Activity" 
                                                     IsChecked="{Binding ActivityLevel, Converter={StaticResource EqualityConverter}, ConverterParameter=Высокий}"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- Кнопки управления -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                                <Button Content="Сохранить профиль" Click="SaveProfile_Click" Width="100" Margin="5"/>
                                <Button Content="Сброс" Click="ResetProfile_Click" Width="60" Margin="5"/>
                            </StackPanel>
                            <Label Content="Последнее сохранение:" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LastSaveText" Text="Никогда" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Привычки">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="Добавление привычки" Margin="5">
                                <StackPanel>
                                    <Label Content="Название привычки:"/>
                                    <TextBox x:Name="NewHabitTextBox" Margin="5"/>
                                    <Label Content="Дата:"/>
                                    <DatePicker x:Name="HabitDatePicker" Margin="5"/>
                                    <Button Content="Добавить привычку" Click="AddHabit_Click" Margin="5"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- DataGrid -->
                            <DataGrid x:Name="HabitsDataGrid" AutoGenerateColumns="False" Height="200" Margin="5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Привычка" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="100"/>
                                    <DataGridTextColumn Header="Время" Binding="{Binding Time, StringFormat='hh\\:mm'}" Width="60"/>
                                    <DataGridCheckBoxColumn Header="Выполнено" Binding="{Binding IsCompleted}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <GroupBox Header="Оценка дня" Margin="5">
                                <StackPanel>
                                    <Label Content="Продуктивность (0-100%)"/>
                                    <Slider x:Name="ProductivitySlider" Minimum="0" Maximum="100" Value="50" ValueChanged="Slider_ValueChanged"/>
                                    <Label Content="Удовлетворенность (0-100%)"/>
                                    <Slider x:Name="SatisfactionSlider" Minimum="0" Maximum="100" Value="50" ValueChanged="Slider_ValueChanged"/>

                                    <Label Content="Общий прогресс дня:"/>
                                    <ProgressBar x:Name="DayProgressBar" Minimum="0" Maximum="100" Height="20" Margin="5" Value="50"/>
                                    <TextBlock x:Name="ProgressTextBlock" Text="50%" HorizontalAlignment="Center"/>

                                    <Button Content="Сохранить оценку дня" Click="SaveDayRating_Click" Margin="5"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Calendar -->
                            <Calendar x:Name="MainCalendar" SelectedDatesChanged="MainCalendar_SelectedDatesChanged" Margin="5"/>

                            <!-- RichTextBox -->
                            <GroupBox Header="Заметки о привычках" Margin="5">
                                <RichTextBox x:Name="NotesRichTextBox" Height="100" Margin="5"/>
                            </GroupBox>

                            <!-- ToggleButton + RepeatButton -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                                <ToggleButton x:Name="EditModeToggle" Content="Режим редактирования" Click="EditModeToggle_Click" Width="140" Margin="2"/>
                                <RepeatButton Content="Увеличить продуктивность (+5)" Click="IncreaseProductivity_Click" Width="180" Margin="2" Delay="500" Interval="100"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Статистика">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Общая сводка -->
                            <GroupBox Header="Общая сводка" Margin="5" Padding="10">
                                <StackPanel>
                                    <TextBlock x:Name="TotalHabitsText" Text="Всего привычек: 0"/>
                                    <TextBlock x:Name="CompletedHabitsText" Text="Выполнено: 0"/>
                                    <TextBlock x:Name="PendingHabitsText" Text="Не выполнено: 0"/>
                                    <TextBlock x:Name="CompletionRateText" Text="Процент выполнения: 0%"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- TreeView -->
                            <GroupBox Header="Категории привычек" Margin="5">
                                <TreeView x:Name="StatsTreeView" SelectedItemChanged="StatsTreeView_SelectedItemChanged">
                                    <TreeViewItem Header="Здоровье" Tag="Health">
                                        <TreeViewItem Header="Бег" Tag="Running"/>
                                        <TreeViewItem Header="Зарядка" Tag="Exercise"/>
                                    </TreeViewItem>
                                    <TreeViewItem Header="Образование" Tag="Education">
                                        <TreeViewItem Header="Чтение" Tag="Reading"/>
                                        <TreeViewItem Header="Программирование" Tag="Coding"/>
                                    </TreeViewItem>
                                    <TreeViewItem Header="Хобби" Tag="Hobbies">
                                        <TreeViewItem Header="Музыка" Tag="Music"/>
                                        <TreeViewItem Header="Рисование" Tag="Drawing"/>
                                    </TreeViewItem>
                                </TreeView>
                            </GroupBox>

                            <!-- ListView статистики -->
                            <GroupBox Header="Статистика по дням" Margin="5">
                                <ListView x:Name="StatsListView" Height="150">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="80"/>
                                            <GridViewColumn Header="Всего" DisplayMemberBinding="{Binding TotalHabits}" Width="50"/>
                                            <GridViewColumn Header="Выполнено" DisplayMemberBinding="{Binding CompletedHabits}" Width="70"/>
                                            <GridViewColumn Header="Продуктивность" DisplayMemberBinding="{Binding Productivity}" Width="100"/>
                                            <GridViewColumn Header="Удовлетворенность" DisplayMemberBinding="{Binding Satisfaction}" Width="120"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </GroupBox>

                            <!-- График продуктивности за неделю -->
                            <GroupBox Header="График продуктивности за неделю" Margin="5">
                                <Canvas x:Name="ProductivityChart" Height="150" Background="#FFF9F9F9"/>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Центральная панель: Сводка и быстрый просмотр -->
            <Grid Grid.Column="1" Margin="5" Background="#FFF5F5F5">
                <StackPanel Margin="10">
                    <TextBlock Text="Быстрая сводка" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="Сегодня" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TodayTotalText" Text="Всего привычек: 0"/>
                            <TextBlock x:Name="TodayCompletedText" Text="Выполнено: 0"/>
                            <ProgressBar x:Name="TodayProgressBar" Height="15" Margin="0,5,0,0" Minimum="0" Maximum="100" Value="0"/>
                            <TextBlock x:Name="TodayPercentText" Text="0%" HorizontalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="Последние добавленные привычки:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ListView x:Name="RecentHabitsList" Height="200">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Привычка" DisplayMemberBinding="{Binding Name}" Width="120"/>
                                        <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding Date, StringFormat='dd.MM'}" Width="60"/>
                                        <GridViewColumn Header="Статус" Width="70">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding IsCompleted, Converter={StaticResource BoolToStatusConverter}}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Правая панель -->
            <Grid Grid.Column="2" Margin="5" Background="#FFF5F5F5">
                <StackPanel Margin="10">
                    <TextBlock Text="Детали статистики" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock x:Name="StatusInfoText" Text="Выберите категорию в дереве" FontStyle="Italic" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- StatusBar -->
        <StatusBar Grid.Row="3" Background="#E0E0E0">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="Готов"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="DateTimeText"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>